#!/bin/bash
# Остановка Манус: гасит контейнер и убирает снимки экрана, сделанные за сеанс.
# Настройки, навыки и файлы задач остаются на месте — они лежат на маке.
#
# Если OpenManus лежит не в домашней папке, поправьте строку REPO ниже.

REPO="$HOME/OpenManus"

set -u

say()  { printf '\n\033[1m%s\033[0m\n' "$1"; }
ok()   { printf '  %s\n' "$1"; }
done_msg() {
    printf '\nНажмите любую клавишу, чтобы закрыть окно…'
    read -r -n 1 -s
    printf '\n'
}

clear
say "Остановка Манус"

cd "$REPO" 2>/dev/null || {
    printf '\n\033[31m✗ Не нашёл папку %s\033[0m\n' "$REPO"
    done_msg
    exit 1
}

if ! docker info >/dev/null 2>&1; then
    ok "Docker не запущен — значит и Манус не работает. Останавливать нечего."
    done_msg
    exit 0
fi

# Снимки лежат внутри контейнера: уберём их, пока он ещё жив. Даже если этого
# не сделать, интерфейс всё равно чистит их при следующем запуске.
docker compose exec -T openmanus rm -rf /tmp/openmanus-screenshots >/dev/null 2>&1 \
    && ok "Снимки экрана удалены" \
    || ok "Снимков не было"

say "Останавливаю контейнер…"
docker compose stop || {
    printf '\n\033[31m✗ Не удалось остановить контейнер. Покажите Клоду строки выше.\033[0m\n'
    done_msg
    exit 1
}

say "Готово"
ok "Настройки, навыки и файлы задач на месте — они хранятся на маке."
ok "Docker Desktop можно закрыть, если он больше не нужен."
done_msg
